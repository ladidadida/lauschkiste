FROM debian:trixie-slim

# These are only dependencies that are required to get as close to the
# Raspberry Pi environment as possible.
RUN apt-get update && apt-get install -y \
    libasound2-dev \
    libportaudio2 \
    pulseaudio \
    pulseaudio-utils \
    --no-install-recommends

ARG UID
ARG USER
ARG HOME
ENV INSTALLATION_PATH=${HOME}/lauschkiste

# The base/macOS Compose configuration runs as root; Linux maps the host UID.
RUN case "${UID}" in \
      ''|*[!0-9]*) echo "UID must be a non-negative integer" >&2; exit 1 ;; \
    esac \
    && if [ "${UID}" -eq 0 ]; then \
         if [ "${USER}" != "root" ]; then \
           echo "UID 0 requires USER=root" >&2; \
           exit 1; \
         fi; \
       else \
         if [ -z "${USER}" ] || [ "${USER}" = "root" ]; then \
           echo "A positive UID requires a non-root USER" >&2; \
           exit 1; \
         fi; \
         useradd -m -u "${UID}" "${USER}"; \
       fi \
    && usermod -aG pulse "${USER}"

# Lauschkiste
# Install all Lauschkiste dependencies
RUN apt-get update && apt-get install -qq -y \
    --allow-downgrades --allow-remove-essential --allow-change-held-packages \
    build-essential at wget \
    espeak mpc mpg123 git ffmpeg spi-tools netcat-openbsd \
    python3 python3-venv python3-dev python3-setuptools python3-mutagen \
    swig unzip

# Generic Debian does not configure Raspberry Pi's repository, so build the lg
# C library here instead of installing the Pi installer's `liblgpio-dev`.
ARG LG_COMMIT=b959a17d723360e85648316757b02dbea9902feb
ARG LG_ARCHIVE_SHA256=3554cd7e60d338b659d38579e6226c46690237d2abe69e8bd77ee7e3b6e615fe
RUN mkdir -p /tmp/lg && cd /tmp/lg \
    && wget --quiet --timeout=30 --tries=3 \
        "https://github.com/joan2937/lg/archive/${LG_COMMIT}.zip" -O lg.zip \
    && echo "${LG_ARCHIVE_SHA256}  lg.zip" | sha256sum --check --status \
    && unzip -q lg.zip \
    && cd "lg-${LG_COMMIT}" \
    && make && make install \
    && cd / && rm -rf /tmp/lg

# uv (package manager), used below to install Python dependencies as $USER. Installed via the
# official script rather than `COPY --from=ghcr.io/astral-sh/uv:latest` since that image has no
# armv7 build (see docker/armv7/lauschkiste.Dockerfile), and this way both Dockerfiles stay consistent.
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN UV_INSTALL_DIR=/usr/local/bin sh /uv-installer.sh && rm /uv-installer.sh

# Copy in the source code using the correct permissions
COPY --chown=${USER}:${USER} . ${INSTALLATION_PATH}/

# Switch to the `$USER` (typically `pi`)
USER ${USER}
WORKDIR ${HOME}

# Initialize venv
ENV VIRTUAL_ENV=${INSTALLATION_PATH}/.venv
RUN python3 -m venv --system-site-packages $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install runtime Python dependencies via uv (see pyproject.toml)
RUN cd ${INSTALLATION_PATH} && uv sync --no-dev

EXPOSE 5556
WORKDIR ${INSTALLATION_PATH}

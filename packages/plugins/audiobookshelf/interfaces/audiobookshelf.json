{
  "events": {},
  "extension_points": {},
  "interface_version": "1.0",
  "kind": "plugin",
  "name": "audiobookshelf",
  "operations": {
    "status": {
      "args": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "query",
      "method": "GET",
      "path": "/api/v1/audiobookshelf/status",
      "returns": {
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reachable": {
            "type": "boolean"
          },
          "waiting": {
            "default": 0,
            "type": "integer"
          }
        },
        "required": [
          "configured",
          "reachable"
        ],
        "type": "object"
      }
    }
  },
  "requires": {
    "audiobooks": ">=2.0,<3",
    "cache": ">=1.0,<2",
    "player": ">=5.2,<6"
  }
}

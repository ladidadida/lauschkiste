#!/usr/bin/env bash
# Login message (installed by `lauschctl setup welcome`)

address="$(hostname -I 2>/dev/null | awk '{print $1}')"

cat <<MESSAGE

  ╭──────────────────────────────────────────────╮
  │   L A U S C H K I S T E                      │
  ╰──────────────────────────────────────────────╯
  Web app:   http://${address:-$(hostname)}:5556
  Status:    systemctl --user status lauschkiste
  Settings:  lauschctl setup --check

MESSAGE

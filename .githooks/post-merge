#!/usr/bin/env bash

# Script to be run by git hook: post merge, i.e. git pull
#
# TO ACTIVATE: cp .githooks/post-merge .git/hooks/.
#
# Checks:
# - Changes to python requirements
# - Changes to Web App
# - Changes to web dependency
# - Changes to the setup steps
#
# Actions are not triggered automatically as they can take some
# time. The user is warned if an action is required.
#
# Inspired by
# https://davidwalsh.name/git-hook-npm-install-package-json-modified

warn_npm_dependency() {
  echo -e "\n"
  echo "************************************************************"
  echo "ATTENTION: npm dependencies have changed since last pull!"
  echo ""
  echo "For workstation development, update dependencies with:"
  echo " cd packages/webapp && npm ci"
  echo ""
  echo "then rebuild the web app: npm run build"
  echo "************************************************************"
  echo -e "\n"
}

warn_webapp() {
  echo -e "\n"
  echo "************************************************************"
  echo "ATTENTION: Web App sources have changed since last pull!"
  echo ""
  echo "Rebuild it with:"
  echo " cd packages/webapp && npm run build"
  echo "('lauschctl update' does this for you if npm is installed)"
  echo "************************************************************"
  echo -e "\n"
}

warn_python_requirements() {
  echo -e "\n"
  echo "************************************************************"
  echo "ATTENTION: Python requirements have changed since last pull!"
  echo ""
  echo "Update the environment with"
  echo " uv sync --no-dev --frozen"
  echo "('lauschctl update' pulls and does this for you)"
  echo "************************************************************"
  echo -e "\n"
}

warn_githooks() {
  echo -e "\n"
  echo "************************************************************"
  echo "ATTENTION: Recommended git hooks changed!"
  echo ""
  echo "To update, REVIEW and copy .githooks/* to .git/hooks"
  echo " cp .githooks/* .git/hooks/."
  echo "************************************************************"
  echo -e "\n"
}

warn_setup() {
  echo -e "\n"
  echo "************************************************************"
  echo "ATTENTION: Setup steps have changed since last pull!"
  echo ""
  echo "Check and re-apply them with"
  echo " lauschctl setup --check"
  echo " lauschctl setup --yes"
  echo "************************************************************"
  echo -e "\n"
}

# files_changed="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD)"
python_req_changed="$(git diff --name-only --no-commit-id ORIG_HEAD HEAD pyproject.toml packages/*/pyproject.toml packages/plugins/*/pyproject.toml uv.lock)"
webapp_changed="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD packages/webapp)"
webapp_dep_changed="$(git diff --name-only --no-commit-id ORIG_HEAD HEAD packages/webapp/package.json)"
githooks_changed="$(git diff --name-only --no-commit-id ORIG_HEAD HEAD .githooks)"
setup_changed="$(git diff --name-only --no-commit-id ORIG_HEAD HEAD packages/cli/src/lauschkiste_cli/setup)"

if [[ -n $python_req_changed ]]; then
    warn_python_requirements
fi

if [[ -n $webapp_dep_changed ]]; then
    warn_npm_dependency
elif [[ -n $webapp_changed ]]; then
    warn_webapp
fi

if [[ -n $githooks_changed ]]; then
    warn_githooks
fi

if [[ -n $setup_changed ]]; then
    warn_setup
fi

echo -e "\nTo see a summary of what happened since your last pull, do:"
echo -e "git show --oneline -s ORIG_HEAD..HEAD\n"
